# Flake integration module for every NixOS host generated by ftl.lib.mkFlake:
# package set (overlays + nixpkgs config), flake registry / NIX_PATH,
# configuration revision and home-manager wiring.
{
  inputs,
  overlays ? [ ],
  nixpkgsConfig ? null,
  exportInputs ? [ ],
  homeManager ? null,
  homeSharedModules ? [ ],
  homeExtraSpecialArgs ? { },
}:
{ lib, ... }:
let
  self = inputs.self or { };
in
{
  config = lib.mkMerge [
    {
      # Overlays apply before any host-specific ones
      nixpkgs.overlays = lib.mkBefore overlays;
      nixpkgs.config = lib.mkIf (nixpkgsConfig != null) nixpkgsConfig;

      system.configurationRevision = lib.mkIf (self ? shortRev || self ? dirtyShortRev) (
        self.shortRev or self.dirtyShortRev
      );

      # Make the flake's inputs available to nix commands on the host
      nix.registry = lib.genAttrs exportInputs (name: {
        flake = inputs.${name};
      });
    }

    (lib.mkIf (inputs ? nixpkgs) {
      # Legacy <nixpkgs> lookups resolve to the flake's nixpkgs
      nix.nixPath = [ "nixpkgs=${inputs.nixpkgs}" ];
      nix.settings.nix-path = "nixpkgs=${inputs.nixpkgs}";
    })

    (lib.optionalAttrs (homeManager != null) {
      home-manager = {
        backupFileExtension = lib.mkDefault "conflict";
        useGlobalPkgs = lib.mkDefault true;
        useUserPackages = lib.mkDefault true;
        sharedModules = homeSharedModules;
        extraSpecialArgs = homeExtraSpecialArgs;
      };
    })
  ];
}
